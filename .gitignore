__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.DS_Store

# パイプラインの生成物 (2026-07-27〜)。
# これらは master にはコミットせず、公開ブランチ gh-pages にのみ置く。
# 理由: charts/*.json だけで1回のrunあたり約15MB増え、日に2〜3回コミットされて
# いたため .git が804MBまで肥大化していた。gh-pages は毎回コミット1個の orphan
# ブランチとして force push するので履歴が積み上がらない。
# 復元/公開は .github/actions/{restore-site-data,publish-site} が担当する。
docs/data/

# 価格キャッシュ (2026-07-27〜)。master ではなく price-cache ブランチに置く。
# 理由: parquet はバイナリで差分が効かず、増分取得のたびに全銘柄のファイルが
# 書き換わるため、1コミットあたり約20MB (1010銘柄実測) がまるごと .git に積まれる。
# 復元/公開は .github/actions/{restore-price-cache,publish-price-cache} が担当する。
data/prices/

# 研究用の長期価格ストア (2026-07-28〜)。tools/fetch_long_history.py が作る。
# 2000年以降 × 全候補約3700銘柄で data/prices/ の20倍以上のサイズになるうえ、
# 運用には一切使わない(閾値検証専用)ので master には載せない。
# 消えても再取得できる。ローカルにだけ置くこと。
data/prices_long/

# 閾値診断の中間行列 (2026-07-28〜)。tools/audit_thresholds_long.py が作る。
# 日付×銘柄の密行列を .npy で十数本、2000年起点だと合計1.5GB超になる。
# sandbox の / は空きが300MB弱しかなく /tmp に置けないのでここに逃がしている。
# 消しても --stage build からやり直せば再生成できる。
data/audit_cache/

# 型1(短期売られすぎリバウンド)の中間行列 (2026-08-19〜)。
# tools/meanrev/run.py --stage build が作る。上と同じく日付×銘柄の密行列で
# 合計600MB級。消しても build からやり直せば再生成できる。
data/mr_cache/

# stage.jsonl backfill の中間状態 (2026-07-30〜)。
# scripts/backfill_stage_history.py の prepare が作る指標フレームの pickle
# (1579銘柄×460本で百MB級) と、replay の進捗・合成 status_history。
# commit フェーズまで通したら消してよい(--reset でも作り直せる)。
data/backfill_cache/

# publish-site アクションが公開ブランチ用に作る一時ファイル
# (publish-price-cache はリポジトリ外の一時ディレクトリで作業するので対象外)
docs/.git/

# 閾値診断レポートの一時ファイル。確定版は data/backtest/ にコミットする。
audit27.txt

# ローカル解析用の秘密鍵置き場 (2026-07-29〜)。
# DASHBOARD_DATA_KEY を .secrets/data_key に1行で置く。tools/pull_site_data.py が読む。
# 公開リポジトリなので絶対にコミットしないこと。
.secrets/

# 復号済みの生成物 (2026-07-29〜)。tools/pull_site_data.py が gh-pages から
# 取ってきて復号したもの。暗号化の意味が消えるので master には絶対に載せない。
data/plain/
